# ==========================================
# 24/7 AI FOUND FOOTAGE VIDEO BOT CONFIGURATION
# ==========================================

# 1. Google Gemini API (Free tier from Google AI Studio)
# Link: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Hugging Face Access Token (Free tier for FLUX.1)
# Link: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_hugging_face_token_here

# 3. YouTube Shorts OAuth 2.0 Credentials (Free from Google Cloud Console)
# Generated via setup_oauth_youtube.py
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-your_client_secret
YOUTUBE_REFRESH_TOKEN=1//your_permanent_refresh_token

# 4. Facebook Reels Graph API (Free from Meta for Developers)
# Link: https://developers.facebook.com/tools/explorer/
FB_PAGE_ID=123456789012345
FB_PAGE_ACCESS_TOKEN=EAA...your_permanent_page_access_token

# 5. 100% Neural AI Video Generation
# Option A: Kling AI 3.0 API (Official Developer Key)
# Link: https://kling.ai/dev/api-key
KLING_API_KEY=api-key-kling-your_key_here

# Option B: Wan 2.2 / 2.1 via SiliconFlow
# Sign up free: https://siliconflow.com
SILICONFLOW_API_KEY=sk-your_siliconflow_api_key_here

# 6. Optional Notification Webhook (Discord / Telegram / Slack)
NOTIFICATION_WEBHOOK=
